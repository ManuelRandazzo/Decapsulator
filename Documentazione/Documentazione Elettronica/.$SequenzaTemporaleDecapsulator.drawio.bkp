        <mxCell id="Y0xiPKhgmKLz6cM2TZ-x-402" value="A metà corsa rallentare il motore per poter raschiare il caffè più a lungo perchè il motore ritorna subito su appena vede il finecorsa FC Punzone DOWN HALL" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;" parent="1" vertex="1">
